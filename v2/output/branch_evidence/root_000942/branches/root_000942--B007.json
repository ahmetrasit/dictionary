      "source_refs": "0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:2187;ayn:file=0170KhalilFarahidi.Cayn.JK000930-ara1:section=heading%3A5252:headword=%D8%B7%D9%81%D9%84:root=%D8%B7%20%D9%81%20%D9%84:sha=70390df2d9e388a2;sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A4108:headword=%D8%B7%D9%81%D9%84:root=%D8%B7%20%D9%81%20%D9%84:sha=8c3b7d095c41f164;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D697%3Bsegment_index%3D4:headword=%D8%B7%D9%81%D9%84:root=%D8%B7%20%D9%81%20%D9%84:sha=69475b86fd3247c4;mufradat:file=0502RaghibIsbahani.Mufradat.Shamela0023636-ara1:section=heading%3A927:headword=%D8%B7%D9%81%D9%84:root=%D8%B7%20%D9%81%20%D9%84:sha=5d2622a015a48c3d",
