      "source_ref": "mufradat:file=0502RaghibIsbahani.Mufradat.Shamela0023636-ara1:section=heading%3A747:headword=%D8%B3%D8%A7%D8%AD:root=%D8%B3%20%D8%A7%20%D8%AD:sha=86e0db8e3ebd1adc",
