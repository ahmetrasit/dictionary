      "source_refs": "ayn:file=0170KhalilFarahidi.Cayn.JK000930-ara1:section=heading%3A2611:headword=%D8%AE%D8%B1%D8%B5:root=%D8%AE%20%D8%B1%20%D8%B5:sha=0bc1f759dd956c6d;sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A2544:headword=%D8%AE%D8%B1%D8%B5:root=%D8%AE%20%D8%B1%20%D8%B5:sha=b705bcd7bae0121b;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D350%3Bsegment_index%3D43:headword=%D8%AE%D8%B1%D8%B5:root=%D8%AE%20%D8%B1%20%D8%B5:sha=5c62ce4ed7127e2a;mufradat:file=0502RaghibIsbahani.Mufradat.Shamela0023636-ara1:section=heading%3A406:headword=%D8%AE%D8%B1%D8%B5:root=%D8%AE%20%D8%B1%20%D8%B5:sha=ceb0f727ef6e9ba9;0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:901;maqayis:root=%D8%AF%20%D8%AE%20%D8%B1%20%D8%B5:headword=%D8%AF%D8%AE%D8%B1%D8%B5:sha=2f478fa60dbaa128",
