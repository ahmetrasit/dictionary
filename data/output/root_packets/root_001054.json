      "source_refs": "ayn:file=0170KhalilFarahidi.Cayn.JK000930-ara1:section=heading%3A1188:headword=%D8%B9%D9%86%D9%83%D8%A8:root=%D8%B9%20%D9%86%20%D9%83%20%D8%A8:sha=0c1f0ffa72cb6c9b;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D206%3Bsegment_index%3D43:headword=%D8%B9%D9%86%D9%83%D8%A8:root=%D8%B9%20%D9%86%20%D9%83%20%D8%A8:sha=80df024fb79a1c23",
