      "source_refs": "0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:634;ayn:file=0170KhalilFarahidi.Cayn.JK000930-ara1:section=heading%3A2061:headword=%D8%AC%D9%87%D8%B1:root=%D8%AC%20%D9%87%20%D8%B1:sha=70907a04173830ed;jamhara:file=0321IbnDuraydAzdi.JamharatLugha.JK007100-ara1:section=heading%3A1250%3Asubentry%3A0%3A%D8%AC%D9%87%D8%B1:headword=%D8%AC%D9%87%D8%B1:root=%D8%AC%20%D9%87%20%D8%B1:sha=758a452eae59c70a;sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A1611:headword=%D8%AC%D9%87%D8%B1:root=%D8%AC%20%D9%87%20%D8%B1:sha=228ef5cc0ae763f7;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D295%3Bsegment_index%3D4:headword=%D8%AC%D9%87%D8%B1:root=%D8%AC%20%D9%87%20%D8%B1:sha=6bf05ec4b49b87fc;mufradat:file=0502RaghibIsbahani.Mufradat.Shamela0023636-ara1:section=heading%3A271:headword=%D8%AC%D9%87%D8%B1:root=%D8%AC%20%D9%87%20%D8%B1:sha=5263111a3fa9b047",
