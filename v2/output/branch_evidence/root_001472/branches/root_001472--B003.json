      "source_refs": "0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:3533;maqayis:root=%D9%86%20%D8%AB%20%D8%B1:headword=%D9%86%D8%AB%D8%B1:sha=9c6823e1115a7bab;jamhara:file=0321IbnDuraydAzdi.JamharatLugha.JK007100-ara1:section=heading%3A1108%3Asubentry%3A0%3A%D9%86%D8%AB%D8%B1:headword=%D9%86%D8%AB%D8%B1:root=%D9%86%20%D8%AB%20%D8%B1:sha=598f41acb8d415d6;sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A1931:headword=%D9%86%D8%AB%D8%B1:root=%D9%86%20%D8%AB%20%D8%B1:sha=d1af949b42587874;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D772%3Bsegment_index%3D6:headword=%D9%86%D8%AB%D8%B1:root=%D9%86%20%D8%AB%20%D8%B1:sha=bec21abf0f2c9dce;mufradat:file=0502RaghibIsbahani.Mufradat.Shamela0023636-ara1:section=heading%3A1464:headword=%D9%86%D8%AB%D8%B1:root=%D9%86%20%D8%AB%20%D8%B1:sha=8055d2c7405ebab8",
