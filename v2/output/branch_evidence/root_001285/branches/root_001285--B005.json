      "source_refs": "0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:3061;jamhara:file=0321IbnDuraydAzdi.JamharatLugha.JK007100-ara1:section=heading%3A624%3Asubentry%3A0%3A%D9%83%D8%AB%D8%A8:headword=%D9%83%D8%AB%D8%A8:root=%D9%83%20%D8%AB%20%D8%A8:sha=174c31a3bc369be3;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D516%3Bsegment_index%3D215:headword=%D9%83%D8%AB%D8%A8:root=%D9%83%20%D8%AB%20%D8%A8:sha=cfd5707d132b411e",
