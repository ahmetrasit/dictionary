    {
      "root_id": "root_001285",
      "branch_id": "B001",
      "root_norm": "ك ث ب",
      "branch_image_ar": "تجمع الشيء حتى يصير كثبة أو كثيبا",
      "what_is_ar": "يدخل فيه جمع الشيء وانكثابه، والكثيب من الرمل، والكثبة أو الطائفة القليلة المجموعة من اللبن أو التمر أو الطعام ونحوه.",
      "what_is_not_ar": "لا يدخل فيه القرب والتمكن المجردان، ولا الكاثبة من الفرس، ولا الكثاب السهم، ولا أسماء المواضع.",
      "source_phrase_ar": "أصل صحيح واحد يدل على تجمع (maqayis)؛ كثبت التراب ونحوه كثبا فانكثب أي نثرته؛ سمي الكثيب؛ كل طائفة من التمر والبر مصبوب فهو كثبة؛ الكثبة القليل من اللبن ونحوه من طعام وغيره (ayn)؛ كثبت الشيء إذا جمعته؛ ومنه اشتقاق الكثيب من الرمل؛ الكثبة كل شيء جمعته من طعام وغيره (jamhara)؛ انكثب الرمل أي اجتمع؛ سمي الكثيب من الرمل؛ الكثبة من اللبن قدر حلبة؛ كل شيء جمعته من طعام أو غيره بعد أن يكون قليلا فهو كثبة (sihah)؛ الكثيب الرمل؛ القطعة من الرمل تنقاد محدودبة؛ كثبت الطعام ونثرته نثرا وهما واحد (tahdhib)؛ رملا متراكما؛ الكثيبة القليل من اللبن والقطعة من التمر سميت بذلك لاجتماعها؛ كثب إذا اجتمع (mufradat)",
      "source_refs": "0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:3061;ayn:file=0170KhalilFarahidi.Cayn.JK000930-ara1:section=heading%3A3762:headword=%D9%83%D8%AB%D8%A8:root=%D9%83%20%D8%AB%20%D8%A8:sha=b4f6b90878e993ac;jamhara:file=0321IbnDuraydAzdi.JamharatLugha.JK007100-ara1:section=heading%3A624%3Asubentry%3A0%3A%D9%83%D8%AB%D8%A8:headword=%D9%83%D8%AB%D8%A8:root=%D9%83%20%D8%AB%20%D8%A8:sha=174c31a3bc369be3;sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A433:headword=%D9%83%D8%AB%D8%A8:root=%D9%83%20%D8%AB%20%D8%A8:sha=58b07967f8f5e9ce;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D516%3Bsegment_index%3D215:headword=%D9%83%D8%AB%D8%A8:root=%D9%83%20%D8%AB%20%D8%A8:sha=cfd5707d132b411e;mufradat:file=0502RaghibIsbahani.Mufradat.Shamela0023636-ara1:section=heading%3A1273:headword=%D9%83%D8%AB%D8%A8:root=%D9%83%20%D8%AB%20%D8%A8:sha=4b68e1900f271cdb",
