      "source_refs": "ayn:file=0170KhalilFarahidi.Cayn.JK000930-ara1:section=heading%3A2342:headword=%D9%88%D9%87%D9%8A:root=%D9%88%20%D9%87%20%D9%8A:sha=c4f9e84e14528c35;jamhara:file=0321IbnDuraydAzdi.JamharatLugha.JK007100-ara1:section=heading%3A595%3Asubentry%3A66%3A%D9%88%D9%87%D9%8A:headword=%D9%88%D9%87%D9%8A:root=%D9%88%20%D9%87%20%D9%8A:sha=b30dc1e0056d26ea;sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A5608:headword=%D9%88%D9%87%D9%89:root=%D9%88%20%D9%87%20%D9%8A:sha=a04082547503efa6;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D315%3Bsegment_index%3D18:headword=%D9%88%D9%87%D9%89:root=%D9%88%20%D9%87%20%D9%89:sha=234b1ed0ee0b02f0;mufradat:file=0502RaghibIsbahani.Mufradat.Shamela0023636-ara1:section=heading%3A1681:headword=%D9%88%D9%87%D9%89:root=%D9%88%20%D9%87%20%D9%8A:sha=6b91de61922d9ad8;0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:4116;maqayis:root=%D9%88%20%D9%87%20%D9%8A:headword=%D9%88%D9%87%D9%8A:sha=ddd5078f884d5d78",
