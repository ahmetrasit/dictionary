        ],
        "passages": [
          {
            "source_ref": "tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D465%3Bsegment_index%3D10:headword=%D8%B1%D8%B2%D9%82:root=%D8%B1%20%D8%B2%20%D9%82:sha=fa5104bc1b1350e7",
            "headword": "رزق",
            "route_status": "exact",
            "entry_text_clean": "# رزق : قال الليث : الرزق معروف ، ورزق الأمير جنده فارتزقوا ارتزاقا . # وقال غيره : الرازق والرزاق من صفة الله جل وعز لأنه يرزق الخلق أجمعين . # قال الله عز وجل : { وما من دآبة في الارض إلا على الله رزقها } ( هود : ~~6 ) . # وأرزاق بني آدم مكتوبة مقدرة لهم ، وهي واصلة إليهم ، جدوا في طلبها أو ~~قصروا . # وقال جل وعز : { تبصرون * وفى السمآء رزقكم وما } ( الذاريات : 22 ms2357 ) . # وقال : { ( يطعمون * إن الله هو الرزاق ذو القوة المتين } ( الذاريات : ~~58 ) . # وفي حديث ابن مسعود عن النبي صلى الله عليه وسلم ( أن الله تعالى يبعث ~~الملك إلى كل من اشتملت عليه رحم أمه فيقول له اكتب رزقه وأجله وعمله وشقي ~~أو سعيد فيختم له على ذلك ) . # وقال مجاهد في قوله : { تبصرون * وفى السمآء رزقكم وما } . قال المطر : ~~وقال في قوله : { ( ليعبدون * مآ أريد منهم من رزق ومآ } ( الذاريات : 57 ) ~~. # يقول : بل أنا أرزقهم وما خلقتهم إلا ليعبدون . # يقول : ما خلقتهم إلا لآمرهم بعبادتي . PageV08P325 # وقال في قوله : { وجد عندها رزقا } ( آل عمران : 37 ) : عنبا في غير حينه ~~. # ويقال : رزق الله الخلق رزقا ورزقا ، فالرزق اسم والرزق مصدر ، وقد يوضع ~~الاسم موضع المصدر . # ويقال : رزق الجند رزقة واحدة ، ورزقوا رزقتين أي مرتين . # وقوله : { مدهنون * وتجعلون رزقكم أنكم تكذبون } ( الواقعة : 82 ) معناه ~~: تجعلون شكر رزقكم التكذيب ، فيقولون : مطرنا بنوء الثريا . # وارتزق القوم : إذا أخذوا أرزاقهم . # أبو عبيد عن أبي عمرو : الرازقية : ثياب كتان بيض . # وقال غيره : الرازقي من الأعناب هو الملاحي . # ق ز ل # قزل قلز زلق لقز زقل لزق .",
            "origin_corpus": "quranic",
