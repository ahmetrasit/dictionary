            "source_ref": "tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D758%3Bsegment_index%3D2:headword=%D8%B0%D8%A8:root=%D8%B0%20%D8%A8:sha=cc68a1b5d83d3dec",
            "headword": "ذب",
