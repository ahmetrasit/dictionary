        "source_refs": [
          "sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A3533:headword=%D8%AD%D8%B1%D9%82:root=%D8%AD%20%D8%B1%20%D9%82:sha=677dbdfcfc31f41b"
