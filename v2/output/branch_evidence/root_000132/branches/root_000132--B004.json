      "source_refs": "0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:290;ayn:file=0170KhalilFarahidi.Cayn.JK000930-ara1:section=heading%3A797:headword=%D8%A8%D8%B9%D8%B1:root=%D8%A8%20%D8%B9%20%D8%B1:sha=5fda5a19dd424028;jamhara:file=0321IbnDuraydAzdi.JamharatLugha.JK007100-ara1:section=heading%3A726%3Asubentry%3A0%3A%D8%A8%D8%B9%D8%B1:headword=%D8%A8%D8%B9%D8%B1:root=%D8%A8%20%D8%B9%20%D8%B1:sha=b3ac8f4ac3fb6c0d;sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A1557:headword=%D8%A8%D8%B9%D8%B1:root=%D8%A8%20%D8%B9%20%D8%B1:sha=1ed19b1eb08ff8ea;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D173%3Bsegment_index%3D7:headword=%D8%A8%D8%B9%D8%B1:root=%D8%A8%20%D8%B9%20%D8%B1:sha=fe00053624c59b7e;mufradat:file=0502RaghibIsbahani.Mufradat.Shamela0023636-ara1:section=heading%3A126:headword=%D8%A8%D8%B9%D8%B1:root=%D8%A8%20%D8%B9%20%D8%B1:sha=4f7324b255e348b8",
