      "branch_image_ar": "السهو سكون",
      "branch_image_en": "stillness",
      "image_en_fit": "close",
      "image_en_gap_note": "-",
      "what_is_ar": "يدخل فيه السهو بمعنى السكون وقولهم جاء سهوا رهوا",
      "what_is_en": "Includes السهو as stillness and the expression came calmly/still.",
      "what_is_not_ar": "ليس الغفلة ولا المساهاة ولا السهوة",
      "source_refs": "0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:1690",
      "source_phrase_ar": "السهو السكون؛ جاء سهوا رهوا",
      "status": "accepted",
      "review_note": "Maqāyīs groups stillness with heedlessness in the broad باب but states السهو السكون separately.",
      "origin_corpus": "furuq",
      "contaminated": "no"
    },
