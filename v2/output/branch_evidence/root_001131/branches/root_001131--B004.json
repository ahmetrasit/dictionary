      "source_refs": "ayn:file=0170KhalilFarahidi.Cayn.JK000930-ara1:section=heading%3A3256:headword=%D8%AF%D9%81%D9%82:root=%D8%AF%20%D9%81%20%D9%82:sha=999c33f1d4bfbeb7;sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A3565:headword=%D8%AF%D9%81%D9%82:root=%D8%AF%20%D9%81%20%D9%82:sha=8a5c74376f48e150;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D466%3Bsegment_index%3D69:headword=%D8%AF%D9%81%D9%82:root=%D8%AF%20%D9%81%20%D9%82:sha=af20eb993dc0b775;mufradat:file=0502RaghibIsbahani.Mufradat.Shamela0023636-ara1:section=heading%3A484:headword=%D8%AF%D9%81%D9%82:root=%D8%AF%20%D9%81%20%D9%82:sha=bee64be2748039fb;0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:1080;maqayis:root=%D8%A7%20%D9%84%20%D8%A7%20%D8%AF%20%D8%B1%20%D9%86%20%D9%81%20%D8%A7%20%D9%82:headword=%D8%A7%D9%84%D8%A7%D8%AF%D8%B1%D9%86%D9%81%D8%A7%D9%82:sha=431d37c2f475ad2f",
