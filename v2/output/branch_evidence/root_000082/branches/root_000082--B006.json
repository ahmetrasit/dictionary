      "source_refs": "0395IbnFarisQazwini.MucjamMaqayis.JK008008-ara1:heading:196;sihah:file=0393IbnHammadJawhari.SihahTajLugha.Shamela0023235-ara1:section=heading%3A3890:headword=%D8%A8%D8%AA%D9%84:root=%D8%A8%20%D8%AA%20%D9%84:sha=164349d250b9fe43;tahdhib:file=tahdhib.sqlite_original:section=parent_entry_id%3D734%3Bsegment_index%3D43:headword=%D8%A8%D8%AA%D9%84:root=%D8%A8%20%D8%AA%20%D9%84:sha=f59d56630a7ba8c0",
