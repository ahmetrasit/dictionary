        "passages": [
          {
            "source_ref": "jamhara:file=0321IbnDuraydAzdi.JamharatLugha.JK007100-ara1:section=heading%3A615%3Asubentry%3A0%3A%D8%AB%D8%A8%D8%B1:headword=%D8%AB%D8%A8%D8%B1:root=%D8%AB%20%D8%A8%20%D8%B1:sha=31420e54ca20fa77",
            "headword": "ثبر",
            "route_status": "exact",
            "entry_text_clean": "# [ ثبر ] وثبرة : موضع معروف . قال الراجز : # # % نجيت نفسي وتركت حزره % % # # % نعم الفتى غادرته بثبره % % # # % لن يسلم الحر الكريم بكره % % # قال أبو بكر : حزرة ابنه وكان بكره . والشعر لعتيبة بن الحارث بن شهاب ~~وهو من الفرسان المعدودين ففر عن ابنه يوم ثبرة ms0190 قتلته بنو تغلب فقال ما قال ~~. # والثبرة : تراب شبيه بالنورة يكون بين ظهري الأرض فإذا بلغ عرق النخلة ~~إليه وقف فيقولون : بلغت النخلة ثبرة من الأرض . # ورجل مثبور : مهلك . # وثبير : جبل معروف وهي أربعة أثبرة كلها بالحجاز . وكانوا يقولون في ~~الجاهلية إذا وقفوا بعرفة : أشرق ثبير كيما نغير . # ومثبر الناقة : الموضع الذي تطرح فيه ولدها وما يخرج معه . # وثبر البحر إذا جزر . # وتثابرت الرجال في الحرب إذا تواثبت . # والمثابر على الشيء : المواظب عليه . # والثبور : الويل والهلاك وكذلك فسر في التنزيل : @QB@ دعوا هنالك ثبورا ~~@QE@ أي ويلا والله أعلم .",
            "origin_corpus": "quranic",
            "section_path": "heading:615:subentry:0:ثبر",
            "page_or_volume_ref": "-"
          }
        ]
      },
      {
        "source_id": "tahdhib",
